# Copy to .env (chmod 600). Never commit .env. Generate secrets with: scripts/install.sh (or python -m app.cli gen-keys)
RR_ENVIRONMENT=production
RR_PUBLIC_HOST=trading.example.com
RR_CORS_ORIGINS=https://trading.example.com
RR_COOKIE_SECURE=true
RR_SESSION_MINUTES=60

POSTGRES_DB=rr_trading
POSTGRES_USER=rr
POSTGRES_PASSWORD=__generate__
REDIS_PASSWORD=__generate__

RR_JWT_SECRET=__generate__
RR_ENCRYPTION_KEY=__generate__          # Fernet key; losing it makes stored broker passwords unrecoverable

# Windows MT5 connector (HTTPS + HMAC). Secret must match the connector's.
RR_BRIDGE_URL=https://10.0.0.20:8443
RR_BRIDGE_SHARED_SECRET=__generate__
RR_BRIDGE_CA_BUNDLE=/run/rr-secrets/connector-ca.pem

# Claude (server-side only — never exposed to the browser)
RR_ANTHROPIC_API_KEY=
RR_CLAUDE_MODEL=claude-opus-5-5
RR_CLAUDE_EFFORT=high
RR_CLAUDE_MAX_CANDIDATES_PER_SCAN=5
RR_CLAUDE_MIN_INTERVAL_SECONDS=300

# Scanner
RR_SCAN_INTERVAL_SECONDS=60
RR_SCAN_TIMEFRAMES=M15,H1,H4
RR_SCAN_MAX_PARALLEL=4
RR_SCAN_BARS=500

# Economic calendar (empty => news risk UNKNOWN => entries blocked unless risk policy allows)
RR_NEWS_PROVIDER=
RR_NEWS_API_URL=
RR_NEWS_API_KEY=
RR_NEWS_BLOCK_MINUTES_BEFORE=30
RR_NEWS_BLOCK_MINUTES_AFTER=30

# Notifications
RR_TELEGRAM_BOT_TOKEN=
RR_TELEGRAM_CHAT_ID=
RR_SMTP_HOST=
RR_SMTP_PORT=587
RR_SMTP_USER=
RR_SMTP_PASSWORD=
RR_SMTP_FROM=
RR_SMTP_TO=
